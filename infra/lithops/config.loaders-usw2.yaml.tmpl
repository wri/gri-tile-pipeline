lithops:
  backend: aws_lambda
  storage: aws_s3
  log_level: INFO

aws:
  region: us-west-2

aws_lambda:
  execution_role: ${EXECUTION_ROLE_ARN}
  region: us-west-2
  architecture: x86_64
  namespace: ttc-dev
  max_workers: 300
  user_tags:
    "Name": "gri-tile-pipeline-loaders-usw2"
    "Project": "gri-tile-pipeline"
    "wri:project": "gri-tile-pipeline"
    "wri:program": "Restoration"
    "ManagedBy": "lithops"

aws_s3:
  region: us-west-2
  storage_bucket: ${STATE_BUCKET_USW2}
