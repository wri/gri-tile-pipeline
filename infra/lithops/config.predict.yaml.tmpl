lithops:
  backend: aws_lambda
  storage: aws_s3
  log_level: INFO

aws:
  region: us-east-1

aws_lambda:
  execution_role: ${EXECUTION_ROLE_ARN}
  region: us-east-1
  architecture: x86_64
  namespace: ttc-dev
  max_workers: 100
  runtime_memory: 6144
  # AWS Lambda hard cap is 900 s (15 min); Lithops reserves a ~5 s buffer.
  runtime_timeout: 900
  # Pin user_id so build identity is irrelevant — last-4 lowercased chars
  # form the ECR repo suffix (lithops_v361_<o56c>_ttc-dev). The o56c value
  # matches the ECS cpu_worker role's STS UserId hash, so sentinel-batch-
  # flow workers invoke the same Lambda image any developer's
  # `make deploy-predict` updates. See feedback_lithops_user_key.md.
  user_id: wri-ttc-shared-o56c

aws_s3:
  region: us-east-1
  storage_bucket: ${STATE_BUCKET_USE1}
