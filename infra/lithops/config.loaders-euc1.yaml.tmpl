lithops:
  backend: aws_lambda
  storage: aws_s3
  log_level: INFO

aws:
  region: eu-central-1

aws_lambda:
  execution_role: ${EXECUTION_ROLE_ARN}
  region: eu-central-1
  architecture: x86_64
  namespace: ttc-dev
  max_workers: 300
  # Pin user_id so build host identity is irrelevant (last-4 lowercased
  # chars form the ECR repo suffix). See feedback_lithops_user_key.md.
  user_id: wri-ttc-shared-o56c

aws_s3:
  region: eu-central-1
  storage_bucket: ${STATE_BUCKET_EUC1}
